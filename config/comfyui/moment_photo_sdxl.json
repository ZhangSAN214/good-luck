{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "底模（换成你下载的 SDXL 二次元底模文件名）"
    },
    "inputs": {
      "ckpt_name": "your_sdxl_anime_model.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "正向提示词"
    },
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "负向提示词"
    },
    "inputs": {
      "text": "{{negative}}",
      "clip": [
        "1",
        1
      ]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "画布"
    },
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "参考图 1（成员设定图）"
    },
    "inputs": {
      "image": "{{ref_1}}"
    }
  },
  "11": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "参考图 2"
    },
    "inputs": {
      "image": "{{ref_2}}"
    }
  },
  "12": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "参考图 3"
    },
    "inputs": {
      "image": "{{ref_3}}"
    }
  },
  "13": {
    "class_type": "ImageBatch",
    "_meta": {
      "title": "合并参考图"
    },
    "inputs": {
      "image1": [
        "10",
        0
      ],
      "image2": [
        "11",
        0
      ]
    }
  },
  "14": {
    "class_type": "ImageBatch",
    "_meta": {
      "title": "合并参考图"
    },
    "inputs": {
      "image1": [
        "13",
        0
      ],
      "image2": [
        "12",
        0
      ]
    }
  },
  "20": {
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": {
      "title": "IPAdapter 加载（ComfyUI_IPAdapter_plus）"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "preset": "PLUS (high strength)"
    }
  },
  "21": {
    "class_type": "IPAdapter",
    "_meta": {
      "title": "IPAdapter：照设定图画人"
    },
    "inputs": {
      "model": [
        "20",
        0
      ],
      "ipadapter": [
        "20",
        1
      ],
      "image": [
        "14",
        0
      ],
      "weight": 0.7,
      "start_at": 0.0,
      "end_at": 1.0,
      "weight_type": "standard"
    }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": {
      "title": "采样"
    },
    "inputs": {
      "seed": "{{seed}}",
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": [
        "21",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "解码"
    },
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "保存"
    },
    "inputs": {
      "filename_prefix": "roundtable",
      "images": [
        "6",
        0
      ]
    }
  }
}
