{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "底模（换成你下载的 SDXL 二次元底模文件名）"
    },
    "inputs": {
      "ckpt_name": "your_sdxl_anime_model.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "正向提示词"
    },
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "负向提示词"
    },
    "inputs": {
      "text": "{{negative}}",
      "clip": [
        "1",
        1
      ]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "画布"
    },
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": {
      "title": "采样"
    },
    "inputs": {
      "seed": "{{seed}}",
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": [
        "1",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "解码"
    },
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "保存"
    },
    "inputs": {
      "filename_prefix": "roundtable",
      "images": [
        "6",
        0
      ]
    }
  }
}
