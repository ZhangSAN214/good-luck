# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 不要把真实 key 写进本文件或任何其他文件。
#
# 所有 key 都是可选的：没有填写 key 的渠道会被自动跳过。
# 至少需要能覆盖 3 个模型（2 个组员 + 1 个统筹）的渠道才能开桌。

# 聚合平台
OPENROUTER_API_KEY=

# 官方直连
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# 联网搜索（可选；成员的 search / fetch 工具。题目内容会发给搜索服务）
TAVILY_API_KEY=

# 可选：本地数据库路径
ROUNDTABLE_DB_PATH=data/roundtable.db
